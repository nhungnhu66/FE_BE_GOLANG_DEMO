# ⛔ CHỈ commit BINARY đã build (build/) + .env.example + README + .gitignore.
# Mã nguồn (Go và Node cũ) giữ ở LOCAL, KHÔNG đẩy lên GitHub: repo công khai, không phơi nghi thức dây
# và chi tiết vận hành ra ngoài. Sửa mã xong thì chạy ./build.sh rồi commit lại binary.

# ── Mã nguồn Go thật (local-only) — chỉ commit bộ fake xkdemo bên dưới ──
/cmd/*
!/cmd/xkdemo/
/cmd/xkdemo/*
!/cmd/xkdemo/main.go
/cmd/gateway/
/internal/*
!/internal/demo/
!/internal/demo/**
/build.sh
/go.local.mod
/go.local.sum

# ── Mã nguồn Node đời cũ + bản sao lưu (local-only) ──
/src/
/test/
/package.json
/package-lock.json
/node_modules/
/backup/
/claude.md

# ── Bí mật + rác build/test ──
.env
*.log
go.mod.decoy.bak
go.sum.decoy.bak
build/*-public.exe
build/*-new.exe
build/*-test.exe
build/xkdemo-fake-test.exe
