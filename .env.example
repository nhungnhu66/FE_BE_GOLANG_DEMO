# ─── Nối về XTRouter_Backend (BẮT BUỘC) ──────────────────────────────────────
# Gốc của backend, KHÔNG kèm namespace (source tự thêm `/gw/mimo`).
XTR_GATEWAY_URL=https://api.xkiro.com
# Bí mật dùng chung — phải TRÙNG `MIMO_GATEWAY_SECRET` bên backend.
# ⛔ Bí mật này KHÔNG bao giờ đi lên dây; chỉ chữ ký của nó đi.
XTR_GATEWAY_SECRET=
# Email tài khoản MiMo — CHÍNH LÀ danh tính gateway. Bảng quản trị đọc cột này để biết
# gateway của tài khoản nào đang chạy, tài khoản nào đang hỏng.
XTR_ACCOUNT_EMAIL=
# Đường dẫn engine.io nếu nginx đặt khác mặc định.
# XTR_GATEWAY_PATH=/socket.io
# Nhãn người đọc (mặc định lấy HOSTNAME của container).
# XTR_LABEL=

# ─── Upstream MiMo (container thường ĐÃ set sẵn ở env global) ────────────────
# Source tự dò theo thứ tự: MIMO_API_KEY → XIAOMI_MIMO_API_KEY → MIMO_KEY
# MIMO_API_KEY=
# Endpoint; tự dò: MIMO_API_BASE_URL → MIMO_BASE_URL → MIMO_ENDPOINT → MIMO_API_BASE
# Mặc định: https://api-sgp-oc.xiaomimimo.com/v1
# MIMO_API_BASE_URL=

# ─── Tuỳ chỉnh vận hành (đều có mặc định hợp lý) ─────────────────────────────
# Số TIẾN TRÌNH con. Mặc định = số lõi container (trần 8). Đặt 1 để chạy một tiến trình.
# XTR_WORKERS=
# Trần lượt chạy CÙNG LÚC **mỗi tiến trình**. Vượt trần → trả `busy` để backend đổi gateway khác.
# Công suất cả container = XTR_WORKERS × XTR_MAX_CONCURRENCY.
# XTR_MAX_CONCURRENCY=16
# Số frame chờ gửi tối đa trước khi NGỪNG đọc upstream (áp lực ngược, chống phình RAM).
# XTR_WRITE_HIGH_WATER=64
# Trần tổng một lượt (ms).
# XTR_REQUEST_TIMEOUT_MS=600000
# Không có chữ nào trong ngần này (ms) ⇒ coi là CÂM.
# XTR_FIRST_TOKEN_TIMEOUT_MS=180000
# Gom mảnh SSE: theo nhịp (ms) và theo byte. 0 = bắn ngay từng mảnh.
# XTR_FLUSH_INTERVAL_MS=25
# XTR_FLUSH_BYTES=16384
# Nhịp gửi `stats` và nhịp đọc lại danh sách model (ms).
# XTR_STATS_INTERVAL_MS=15000
# XTR_MODELS_REFRESH_MS=1800000
# Chờ lượt đang chạy khi nhận SIGTERM (ms).
# XTR_SHUTDOWN_GRACE_MS=20000
# debug | info | warn | error ; XTR_LOG_JSON=1 để log JSON một dòng.
# XTR_LOG_LEVEL=info
# XTR_LOG_JSON=
